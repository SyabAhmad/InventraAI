# ============================
# AI Inventory Agent - Config
# ============================

# --- LLM provider (OpenAI-compatible) ---
# You can use ANY OpenAI-compatible provider by changing these values.
# Examples:
#   Ollama Cloud : LLM_BASE_URL=https://ollama.com/v1
#   Groq         : LLM_BASE_URL=https://api.groq.com/openai/v1
#   OpenAI       : LLM_BASE_URL=https://api.openai.com/v1
#   Local Ollama : LLM_BASE_URL=http://localhost:11434/v1
LLM_PROVIDER=ollama
LLM_BASE_URL=https://ollama.com/v1
LLM_API_KEY=
LLM_MODEL=gemma4:31b
# --- Benchmark models (Ollama Cloud via LLM_BASE_URL=https://ollama.com/v1) ---
# Verified online at ollama.com/library on 2026-11-05:
#   gpt-oss:20b          OK  (API name) / CLI: gpt-oss:20b-cloud
#   gemma4:31b           OK  (API name) / CLI: gemma4:31b-cloud
#   nemotron-3-nano:30b  OK  (API name) / CLI: nemotron-3-nano:30b-cloud
#   qwen3.5:35b          OK  (local 22GB) / NO qwen3.5:35b-cloud exists.
#                        True cloud Qwen 3.5 is qwen3.5:cloud (397B-A17B).
#   deepseek-v4.1-flash  OK  (cloud-only chat model, 1M ctx, tools+thinking)
#                        Replaces Clef in the CHAT benchmark (see below).
# NOTE: For https://ollama.com/v1 use the BASE name (no -cloud suffix).
# The -cloud suffix is only for `ollama run` CLI.
LLM_BENCHMARK_MODELS=gpt-oss:20b,gemma4:31b,nemotron-3-nano:30b,qwen3.5:35b,deepseek-v4.1-flash

# --- Clef (decision-only, NOT a chat LLM) ---
# Clef is a 27B decision model (Cloudflare) via /v1/systemone, NOT via
# /v1/chat/completions, so it cannot run the LangGraph tool-calling agent.
# It is kept as a separate check: python scripts/check_clef.py
CLEF_MODEL=clef:27b

# --- Backward-compatible aliases (optional, same as above) ---
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b
OLLAMA_BENCHMARK_MODELS=gpt-oss:20b,gemma4:31b,nemotron-3-nano:30b,qwen3.5:35b,deepseek-v4.1-flash

# --- Database ---
DATABASE_PATH=data/inventory.db

# --- Inventory rules ---
DEFAULT_MIN_STOCK=20
LOW_STOCK_ALERT_THRESHOLD=20
REORDER_SAFETY_FACTOR=1.5
REORDER_LEAD_TIME_DAYS=7
MIN_REORDER_QTY=10
MAX_REORDER_QTY=500

# --- Forecasting ---
FORECAST_HORIZON_DAYS=7
FORECAST_VALIDATION_DAYS=14
FORECAST_METHOD=moving_average

# --- Agent ---
AGENT_MAX_ITERATIONS=8
AGENT_TEMPERATURE=0.2

# --- Benchmarking ---
BENCHMARK_REPEATS=3
BENCHMARK_OUTPUT_DIR=benchmark_results

# --- API / Frontend ---
API_HOST=127.0.0.1
API_PORT=8000