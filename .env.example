# ============================
# AI Inventory Agent - Config
# ============================

# --- Ollama Cloud (LLM) ---
# Base URL for Ollama Cloud (OpenAI-compatible). Override if self-hosting Ollama.
OLLAMA_BASE_URL=https://ollama.com/v1
# API key for Ollama Cloud (required for cloud; leave empty for local Ollama)
OLLAMA_API_KEY=
# Default model used by the agent and dashboard
OLLAMA_MODEL=llama3.1:8b
# Comma-separated list of models to benchmark (used by benchmark runner)
OLLAMA_BENCHMARK_MODELS=llama3.1:8b,qwen2.5:3b,gemma2:2b

# --- Database ---
DATABASE_PATH=data/inventory.db

# --- Inventory rules ---
DEFAULT_MIN_STOCK=20
LOW_STOCK_ALERT_THRESHOLD=20
REORDER_SAFETY_FACTOR=1.5
REORDER_LEAD_TIME_DAYS=7
MIN_REORDER_QTY=10
MAX_REORDER_QTY=500

# --- Forecasting ---
FORECAST_HORIZON_DAYS=7
FORECAST_VALIDATION_DAYS=14
FORECAST_METHOD=moving_average

# --- Agent ---
AGENT_MAX_ITERATIONS=8
AGENT_TEMPERATURE=0.2

# --- Benchmarking ---
BENCHMARK_REPEATS=3
BENCHMARK_OUTPUT_DIR=benchmark_results

# --- API / Frontend ---
API_HOST=127.0.0.1
API_PORT=8000