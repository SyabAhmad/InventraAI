# ============================
# AI Inventory Agent - Config
# ============================

# --- LLM provider (OpenAI-compatible) ---
# You can use ANY OpenAI-compatible provider by changing these values.
# Examples:
#   Ollama Cloud : LLM_BASE_URL=https://ollama.com/v1
#   Groq         : LLM_BASE_URL=https://api.groq.com/openai/v1
#   OpenAI       : LLM_BASE_URL=https://api.openai.com/v1
#   Local Ollama : LLM_BASE_URL=http://localhost:11434/v1
LLM_PROVIDER=ollama
LLM_BASE_URL=https://ollama.com/v1
LLM_API_KEY=
LLM_MODEL=gemma4:31b
# Comma-separated list of models to benchmark (used by benchmark runner)
LLM_BENCHMARK_MODELS=gemma4:31b,gemma4:31b-cloud

# --- Backward-compatible aliases (optional, same as above) ---
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b
OLLAMA_BENCHMARK_MODELS=gemma4:31b,gemma4:31b-cloud

# --- Database ---
DATABASE_PATH=data/inventory.db

# --- Inventory rules ---
DEFAULT_MIN_STOCK=20
LOW_STOCK_ALERT_THRESHOLD=20
REORDER_SAFETY_FACTOR=1.5
REORDER_LEAD_TIME_DAYS=7
MIN_REORDER_QTY=10
MAX_REORDER_QTY=500

# --- Forecasting ---
FORECAST_HORIZON_DAYS=7
FORECAST_VALIDATION_DAYS=14
FORECAST_METHOD=moving_average

# --- Agent ---
AGENT_MAX_ITERATIONS=8
AGENT_TEMPERATURE=0.2

# --- Benchmarking ---
BENCHMARK_REPEATS=3
BENCHMARK_OUTPUT_DIR=benchmark_results

# --- API / Frontend ---
API_HOST=127.0.0.1
API_PORT=8000